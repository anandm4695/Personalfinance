{
  "buildCommand": "npm run build",
  "outputDirectory": "build",
  "functions": {
    "api/health.js":       { "maxDuration": 10 },
    "api/stock-logo.js":   { "maxDuration": 15 },
    "api/stock-chart.js":  { "maxDuration": 15 },
    "api/stock-price.js":  { "maxDuration": 10 },
    "api/mf-nav.js":       { "maxDuration": 10 },
    "api/rc-lookup.js":    { "maxDuration": 15 },
    "api/send-summary.js": { "maxDuration": 60 },
    "api/cron-update-prices.js": { "maxDuration": 60 }
  },
  "crons": [
    {
      "path": "/api/send-summary?action=cron",
      "schedule": "30 2 * * *"
    },
    {
      "path": "/api/cron-update-prices",
      "schedule": "30 12 * * 1-5"
    }
  ],
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
