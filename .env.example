# ──────────────────────────────────────────────────────
# Personal Finance by Anand Mohta — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit your actual .env file to version control.
# ──────────────────────────────────────────────────────

# ── LIVE / PRODUCTION database ─────────────────────────
# Supabase project URL (found in Project Settings → API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase anon/public key (found in Project Settings → API)
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ── DEMO / STAGING database ────────────────────────────
# A separate Supabase project used when "Explore Demo Mode" is clicked.
# Create a second Supabase project, run all database migrations on it,
# create a user account there, then fill in the values below.
# If these are left as placeholders the app falls back to offline mode.
VITE_SUPABASE_DEMO_URL=https://your-demo-project-id.supabase.co
VITE_SUPABASE_DEMO_ANON_KEY=your-demo-anon-key-here

# Credentials for the pre-created demo user in the staging Supabase project.
# This account is signed in automatically when "Explore Demo Mode" is clicked.
VITE_DEMO_USER_EMAIL=demo@yourapp.com
VITE_DEMO_USER_PASSWORD=your-demo-password-here
