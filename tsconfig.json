{
    "include": [
        "./src/**/*"
    ],
    "compilerOptions": {
        "strict": true,
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "moduleResolution": "bundler",
        "module": "esnext",
        "target": "es2020",
        "lib": [
            "dom",
            "dom.iterable",
            "es2020"
        ],
        "types": ["vite/client", "vitest/globals", "node"],
        "jsx": "react-jsx",
        "skipLibCheck": true,
        "resolveJsonModule": true,
        "isolatedModules": true,
        "noEmit": true
    }
}
